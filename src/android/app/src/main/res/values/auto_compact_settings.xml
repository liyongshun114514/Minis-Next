<?xml version="1.0" encoding="utf-8"?>
<!--
  [T-android-auto-compact-settings] Settings › Context Compaction.

  Kept in its own file, like the other feature pages, so the base strings.xml
  stays navigable. Only values/ and values-zh/ are provided; every other locale
  falls back to English rather than a machine translation.
-->
<resources>
    <string name="auto_compact_settings_title">Context Compaction</string>
    <string name="auto_compact_settings_subtitle">Threshold and summary model</string>

    <string name="auto_compact_switch_title">Auto-compact on threshold</string>
    <string name="auto_compact_switch_footer">On: when the next request would cross the threshold, the conversation is compacted silently and then sent. Off: you are asked before compacting.</string>

    <string name="auto_compact_threshold_title">Token threshold</string>
    <string name="auto_compact_threshold_default">Model default</string>
    <string name="auto_compact_threshold_default_subtitle">Using the capacity-derived default for the active model.</string>
    <string name="auto_compact_threshold_value_fmt">%1$s tokens</string>
    <string name="auto_compact_threshold_dialog_title">Token threshold</string>
    <string name="auto_compact_threshold_dialog_label">Tokens</string>
    <string name="auto_compact_threshold_dialog_hint">Leave empty to use the capacity-derived default for the active model.</string>
    <string name="auto_compact_threshold_error_positive">Enter a whole number greater than 0.</string>
    <string name="auto_compact_threshold_error_too_large">Too large. The maximum is %1$s.</string>
    <string name="auto_compact_threshold_use_default">Use model default</string>

    <string name="auto_compact_model_title">Compaction model</string>
    <string name="auto_compact_model_follow_chat">Follow current chat model</string>
    <string name="auto_compact_model_entry_fmt">%1$s · %2$s</string>
    <string name="auto_compact_model_picker_title">Compaction model</string>
    <string name="auto_compact_model_missing_fmt">Saved model %1$s is no longer in your provider list. It is kept until you choose another.</string>
    <string name="auto_compact_model_unavailable_fmt">Saved model %1$s is unavailable (provider disabled, entry hidden, or not a text model). It is kept until you choose another.</string>
    <string name="auto_compact_model_none">No enabled text model is available. Add or enable a provider first.</string>
    <string name="auto_compact_model_footer">The summary request uses this model; your chat model does not change. Availability is checked locally, so browsing this page makes no extra model call.</string>
</resources>
