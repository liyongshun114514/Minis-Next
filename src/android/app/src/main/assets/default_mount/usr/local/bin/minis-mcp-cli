#!/bin/sh
# minis-mcp-cli — Minis Next MCP client for the Android Ubuntu guest.
# Use the apt-managed interpreter, never a caller's venv/custom Python. Ship
# dependencies in the image; repair older images with apt, not global pip.

LOG="/var/minis/mcp-servers/mcp-cli.log"
PYTHON=/usr/bin/python3
# The host owns the MCP mount. Do not create a local directory shadowing it.
# Failure to open the log must not stop dependency repair or the command.
if ! { command exec 3>>"$LOG"; } 2>/dev/null; then
  exec 3>/dev/null
fi
_log() { printf '%s\n' "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >&3; }

# -I ignores PYTHONHOME/PYTHONPATH/user-site and venv activation. main.py adds
# its own packaged library path explicitly; the forked daemon inherits it.
if [ ! -x "$PYTHON" ]; then
  _log "Installing Ubuntu system Python..."
  if ! { apt-get -qq update &&
      DEBIAN_FRONTEND=noninteractive apt-get -qq install -y --no-install-recommends python3; } >&3 2>&1; then
    printf '%s\n' 'minis-mcp-cli: Ubuntu python3 installation failed; see MCP log if available.' >&2
    exit 1
  fi
fi

# Import the full HTTP stack, including SOCKS support (omitted by apt's
# --no-install-recommends). Merely importing httpx misses optional deps.
if ! "$PYTHON" -I -c 'import httpx, httpcore, socksio; httpx.Client(trust_env=False).close()' 2>/dev/null; then
  _log "Repairing Ubuntu MCP HTTP runtime..."
  if ! { apt-get -qq update &&
      DEBIAN_FRONTEND=noninteractive apt-get -qq install -y --no-install-recommends python3-httpx python3-httpcore python3-socksio; } >&3 2>&1; then
    printf '%s\n' 'minis-mcp-cli: Ubuntu MCP HTTP runtime installation failed; see MCP log if available.' >&2
    exit 1
  fi
  if ! "$PYTHON" -I -c 'import httpx, httpcore, socksio; httpx.Client(trust_env=False).close()' 2>/dev/null; then
    printf '%s\n' 'minis-mcp-cli: system Python cannot import the MCP HTTP runtime after installation.' >&2
    exit 1
  fi
fi

exec 3>&-
exec "$PYTHON" -I /usr/local/lib/minis-mcp-cli/main.py "$@"
